{
  "expo": {
    "name": "CustodiCore",
    "slug": "custodicore",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/91bdab4f-6989-4532-90f8-0f99edcf0708"
    },
    "orientation": "portrait",
    "scheme": "custodicore",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yuttq.custodicore",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "CustodiCore needs access to your photos so you can upload verification documents and choose a profile picture.",
          "cameraPermission": "CustodiCore needs access to your camera so you can take photos for verification documents and your profile."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CustodiCore needs camera access to scan QR codes when you open the scanner."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "91bdab4f-6989-4532-90f8-0f99edcf0708"
      }
    },
    "owner": "yuttq"
  }
}
