# Copy this file to `.env` in the repo root and fill in values for local mobile development.
# Restart Expo after changing any of these — Expo reads them at startup.

# Laravel API base URL for the visitor mobile app (include `/api`, no trailing slash).
# Do NOT use localhost on a physical Android phone — use your PC's LAN IP.
# Example shape only (replace with your actual LAN IP):
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api
EXPO_PUBLIC_API_URL=http://YOUR-PC-LAN-IP:8000/api

# Google Sign-In OAuth client IDs (optional until Google auth is wired up).
# Leave blank to disable Google Sign-In in the mobile app.
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
