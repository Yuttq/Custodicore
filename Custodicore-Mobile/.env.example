# Copy this file to `.env` in the repo root and fill in values for local mobile development.
# Restart Expo after changing any of these - Expo reads them at startup.

# Laravel API base URL for the visitor mobile app (include `/api`, no trailing slash after it).
# Use your computer's LAN IP when testing on a physical device (not localhost).
EXPO_PUBLIC_API_URL=http://YOUR-LAN-IP:8000/api

# Google Sign-In OAuth client IDs (optional until Google auth is wired up).
# Leave blank to disable Google Sign-In in the mobile app.
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
