APP_NAME=CustodiCore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Not connected yet — CustodiCore Database Design doc + custodicore_schema.sql
# has the matching MySQL schema. Fill these in and run `php artisan migrate`
# only when you're ready to wire the dashboard to real data.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=custodicore
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
# To really send the staff "set up your account" emails, switch to smtp and fill these in:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=no-reply@your-domain.example
# MAIL_FROM_NAME="${APP_NAME}"

# Staff account setup links (sent by email + SMS after the Warden registers an officer)
STAFF_INVITATION_EXPIRE_HOURS=72
# SMS: 'log' just writes to storage/logs/laravel.log. Use 'semaphore' to send real texts.
SMS_DRIVER=log
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Google Sign-In (mobile visitors): comma-separated OAuth client IDs
# accepted as the ID token audience. Leave empty to disable.
GOOGLE_CLIENT_IDS=
