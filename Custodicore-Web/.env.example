APP_NAME=CustodiCore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost

# Shared password for the db:seed DEMO accounts. Blank = "password", but only when
# APP_ENV is local or testing; every other environment must set it to seed demo data.
SEED_PASSWORD=
# APP_ENV=production seeds reference data only (roles, modules, permissions, base
# visiting rules): no demo accounts. true = also seed the demo accounts and records,
# for a demo server only, never a real facility. A real Warden is created with
# `php artisan cc:create-first-warden` (see README "Production setup: the first Warden").
SEED_DEMO_DATA=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logging. The values below are for local development.
# Production (Azure App Service, Droplet):
#     LOG_STACK=daily      -> one file per day: logs/laravel-YYYY-MM-DD.log
#     LOG_LEVEL=warning    -> never debug in production
#     LOG_DAILY_DAYS=14    -> files older than this are deleted automatically
# Logs go to storage/logs, or to $LARAVEL_STORAGE_PATH/logs when that is set
# (Azure: /home/custodicore/storage/logs, kept across restarts and deployments).
# Query values (names, emails, ID numbers) are replaced before anything is written.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Not connected yet — CustodiCore Database Design doc + custodicore_schema.sql
# has the matching MySQL schema. Fill these in and run `php artisan migrate`
# only when you're ready to wire the dashboard to real data.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=custodicore
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Mobile app sign-in tokens stop working this many minutes after sign-in
# (43200 = 30 days); the visitor then signs in again. See config/sanctum.php.
SANCTUM_EXPIRATION=43200

CACHE_STORE=database
QUEUE_CONNECTION=database

# Emails: visitor email verification, password reset, staff setup links, staff
# two-step codes, account approved. Sent straight away (no queue worker needed).
# MAIL_MAILER=log  -> DEVELOPMENT ONLY. Nothing is sent; with LOG_LEVEL=debug the whole email
#                     (including its link or code) is written to storage/logs/laravel.log, and with
#                     a higher LOG_LEVEL it is dropped. Production must use smtp (the app logs a
#                     critical warning when it runs in production with log or array).
# To send REAL emails, switch to smtp and fill in the sender account below, then
# run `php artisan config:clear` and restart `php artisan serve`. Test with:
#     php artisan cc:mail-test you@example.com
MAIL_MAILER=log
# true = refuse to send unless the connection is encrypted (STARTTLS). Use true in production.
MAIL_REQUIRE_TLS=false
# --- Gmail example (turn on 2-Step Verification, then create an App Password at
# --- myaccount.google.com/apppasswords. Use the 16 letters WITHOUT spaces, not your real password):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=yourgmail@gmail.com
# MAIL_PASSWORD=abcdefghijklmnop
# MAIL_FROM_ADDRESS=yourgmail@gmail.com
# MAIL_FROM_NAME="${APP_NAME}"
# --- Production: Azure Communication Services Email (SMTP). See README "Azure Communication
# --- Services Email". Put MAIL_USERNAME / MAIL_PASSWORD in App Settings or Key Vault, never in git.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.azurecomm.net
# MAIL_PORT=587
# MAIL_SCHEME=                      # leave empty: smtp + STARTTLS on 587 (not smtps)
# MAIL_REQUIRE_TLS=true
# MAIL_USERNAME=<ACS SMTP Username>
# MAIL_PASSWORD=<Entra app client secret>
# MAIL_FROM_ADDRESS=DoNotReply@your-verified-domain.example
# MAIL_FROM_NAME="CustodiCore"

# Staff account setup links (sent by email + SMS after the Warden registers an officer)
STAFF_INVITATION_EXPIRE_HOURS=72
# SMS: 'log' just writes to storage/logs/laravel.log. Use 'semaphore' to send real texts.
SMS_DRIVER=log
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Staff two-step verification (web dashboards only; mobile visitors are not affected).
# true = every staff member sets up an authenticator app at their next sign-in and
# needs a code after the password. false turns it off for everyone (there is no
# opt-in mode). Lost phone + backup codes: php artisan cc:mfa-reset <email-or-username>
# Keep APP_KEY unchanged in production: saved secrets and backup codes depend on it.
STAFF_MFA_REQUIRED=true

# Proxies allowed to report the visitor's real IP and HTTPS (X-Forwarded-For/-Proto/-Port).
# Leave empty locally. Azure App Service: REMOTE_ADDR (trust only the App Service front end
# connecting to the app). Azure Front Door in front of App Service: REMOTE_ADDR plus Front Door's
# published "AzureFrontDoor.Backend" ranges, comma-separated. Never 0.0.0.0/0 or "**" (ignored).
TRUSTED_PROXIES=

# HTTPS (production). Azure App Service: turn on "HTTPS Only" and set TRUSTED_PROXIES first.
# SESSION_SECURE_COOKIE=true   -> the session cookie is never sent over plain http.
# HSTS_MAX_AGE (seconds, 0 = off) tells browsers to use https only. Sent on HTTPS requests only.
#   Start at 86400 (1 day) once the site is confirmed working over https; raise to 31536000
#   (1 year) after sign-in, MFA, document viewing and QR scanning are checked. No subdomains,
#   no preload. Leave 0 for local development.
HSTS_MAX_AGE=0

# Google Sign-In (mobile visitors): comma-separated OAuth client IDs
# accepted as the ID token audience. Leave empty to disable.
GOOGLE_CLIENT_IDS=
